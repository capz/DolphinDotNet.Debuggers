<idea-plugin>
    <id>com.dolphindotnet.debugger</id>
    <name>DolphinDotNet</name>
    <vendor>DolphinDotNet</vendor>
    <description>Attach to an already-running Dolphin or GameCube GDB target using the DolphinDotNet DAP adapter.</description>
    <depends>com.intellij.modules.rider</depends>
    <depends>com.intellij.modules.xdebugger</depends>
    <extensions defaultExtensionNs="com.intellij">
        <configurationType implementation="com.dolphindotnet.rider.AttachConfigurationType"/>
        <programRunner implementation="com.dolphindotnet.rider.AttachRunner"/>
        <configurationType implementation="com.dolphindotnet.rider.LaunchConfigurationType"/>
        <programRunner implementation="com.dolphindotnet.rider.LaunchRunner"/>
        <statusBarWidgetFactory implementation="com.dolphindotnet.rider.TargetStatusWidgetFactory" id="DolphinDotNet.Target" order="before Memory"/>
        <xdebugger.breakpointType implementation="com.dolphindotnet.rider.SourceBreakpointType"/>
    </extensions>
    <actions>
        <action id="DolphinDotNet.Attach" class="com.dolphindotnet.rider.AttachAction"
                text="Attach to Nintendo GameCube…" description="Attach Rider to a running Dolphin or GameCube debug build">
            <add-to-group group-id="XDebugger.AttachGroup" anchor="after"
                          relative-to-action="com.jetbrains.rider.debugger.actions.RiderAttachToRemoteProcessAction"/>
        </action>
    </actions>
</idea-plugin>
